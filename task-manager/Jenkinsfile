def appImage

pipeline {
  agent any

  environment {
    DOCKER_USER = 'VPbanna123'
    IMAGE_NAME = 'task-manager-app'
    IMAGE_TAG = "${env.BUILD_ID}"
    REGISTRY = "docker.io/${DOCKER_USER}/${IMAGE_NAME}"
    CONTAINER_NAME = 'task-manager-app'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          appImage = docker.build("${REGISTRY}:${IMAGE_TAG}", ".")
        }
      }
    }

    stage('Push to Docker Hub') {
      steps {
        script {
          docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
            appImage.push()
            appImage.push('latest')
          }
        }
      }
    }

    stage('Deploy Container') {
      steps {
        sh '''
          docker stop ${CONTAINER_NAME} || true
          docker rm ${CONTAINER_NAME} || true
          docker run -d --name ${CONTAINER_NAME} -p 3000:80 ${REGISTRY}:latest
        '''
      }
    }
  }

  post {
    always {
      sh "docker rmi ${REGISTRY}:${IMAGE_TAG} || true"
    }
  }
}
